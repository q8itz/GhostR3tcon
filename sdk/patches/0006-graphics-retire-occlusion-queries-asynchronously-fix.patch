+      occlusion_query_index_pending_[host_index] = true;
+    }
+  }
+  PendingOcclusionQuery& pending = pending_occlusion_queries_.emplace_back();
+  pending.submission = GetCurrentSubmission();
+  pending.end_record = end_record;
+  pending.segment_indices = std::move(segment_indices);

+  uint32_t slot_base = sample_count_address & ~uint32_t(0x3F);
+  uint32_t end_record = slot_base != 0 ? slot_base : sample_count_address;
+  DropPendingOcclusionQueries(slot_base);
+  if (segment_indices.empty()) {

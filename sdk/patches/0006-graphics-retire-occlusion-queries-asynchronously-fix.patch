+
+void VulkanCommandProcessor::DropPendingOcclusionQueries(uint32_t slot_base) {
+  for (auto it = pending_occlusion_queries_.begin(); it != pending_occlusion_queries_.end();) {
+    if ((it->end_record & ~uint32_t(0x3F)) != slot_base) {
+      ++it;
+      continue;
+    }
+    for (uint32_t host_index : it->segment_indices) {
+      if (host_index < occlusion_query_index_pending_.size()) {
+        occlusion_query_index_pending_[host_index] = false;
+      }
+    }
+    it = pending_occlusion_queries_.erase(it);
+  }
+}
+
+void VulkanCommandProcessor::RetireOcclusionQueries(bool await) {
+  if (pending_occlusion_queries_.empty()) {
+    return;
+  }
+  uint64_t completed_before = submission_completed_;
+  // Awaiting is limited to submissions already sent, so that this never ends
+  // the open submission underneath a caller that is recording into it.
+  CheckSubmissionFenceAndDeviceLoss(await ? std::min(pending_occlusion_queries_.front().submission,
+                                                     GetCurrentSubmission() - 1)
+                                          : 0);
+  if (pending_occlusion_queries_.front().submission > submission_completed_) {
+    return;
   }
 
   const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
-  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
-  const VkDevice device = vulkan_device->device();
-  if (!(vulkan_device->memory_types().host_coherent &
-        (uint32_t(1) << occlusion_query_readback_memory_type_))) {
-    VkMappedMemoryRange memory_range = {};
-    memory_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
-    memory_range.memory = occlusion_query_readback_memory_;
-    memory_range.offset = 0;
-    memory_range.size =
-        std::min(rex::round_up(VkDeviceSize(sizeof(uint64_t) * kMaxOcclusionQueries),
-                               vulkan_device->properties().nonCoherentAtomSize),
-                 occlusion_query_readback_memory_size_);
-    dfn.vkInvalidateMappedMemoryRanges(device, 1, &memory_range);
+  if (submission_completed_ != completed_before || await) {
+    if (!(vulkan_device->memory_types().host_coherent &
+          (uint32_t(1) << occlusion_query_readback_memory_type_))) {
+      const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+      VkMappedMemoryRange memory_range = {};
+      memory_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      memory_range.memory = occlusion_query_readback_memory_;
+      memory_range.offset = 0;
+      memory_range.size =
+          std::min(rex::round_up(VkDeviceSize(sizeof(uint64_t) * kMaxOcclusionQueries),
+                                 vulkan_device->properties().nonCoherentAtomSize),
+                   occlusion_query_readback_memory_size_);
+      dfn.vkInvalidateMappedMemoryRanges(vulkan_device->device(), 1, &memory_range);
+    }
   }
 
   const uint64_t* results = reinterpret_cast<const uint64_t*>(occlusion_query_readback_mapping_);
-  uint64_t samples = 0;
-  for (uint32_t host_index : segment_indices) {
-    if (host_index < kMaxOcclusionQueries) {
-      samples += results[host_index];
+  while (!pending_occlusion_queries_.empty() &&
+         pending_occlusion_queries_.front().submission <= submission_completed_) {
+    PendingOcclusionQuery& pending = pending_occlusion_queries_.front();
+    uint64_t samples = 0;
+    for (uint32_t host_index : pending.segment_indices) {
+      if (host_index < kMaxOcclusionQueries) {
+        samples += results[host_index];
+        occlusion_query_index_pending_[host_index] = false;
+      }
     }
+    WriteGuestOcclusionResult(pending.end_record, NormalizeOcclusionSamples(samples));
+    pending_occlusion_queries_.pop_front();
   }
-  samples = NormalizeOcclusionSamples(samples);
-  // The guest subtracts the BEGIN record from the END record. BEGIN was cleared
-  // to zero when the query opened, so the whole delta belongs in the END record.
-  uint32_t slot_base = sample_count_address & ~uint32_t(0x3F);
-  uint32_t end_record = slot_base != 0 ? slot_base : sample_count_address;
-  WriteGuestOcclusionResult(end_record, samples);
-  return true;
+}
+
+bool VulkanCommandProcessor::OnWorkerIdle() {
+  if (pending_occlusion_queries_.empty()) {
+    return false;
+  }
+  // The guest may be spinning on a result recorded into the open submission.
+  if (submission_open_ && pending_occlusion_queries_.back().submission >= GetCurrentSubmission()) {
+    EndSubmission(false);
+  }
+  RetireOcclusionQueries(false);
+  return !pending_occlusion_queries_.empty();
 }
 

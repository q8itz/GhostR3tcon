+
 std::optional<KernelState::RecompiledModuleInfo> KernelState::FindRecompiledModule(
     std::string_view guest_path) {
   auto global_lock = global_critical_region_.Acquire();
   auto normalized = NormalizeGuestPath(guest_path);
+  const auto query_slash = normalized.rfind('/');
+  const std::string_view query_file = query_slash == std::string::npos
+                                         ? std::string_view(normalized)
+                                         : std::string_view(normalized).substr(query_slash + 1);
   for (const auto& info : recompiled_modules_) {
-    if (info.guest_path == normalized)
+    if (info.guest_path == normalized) {
       return info;
+    }
+    // LaunchTitle joins a bare filename onto the running title's directory
+    // (\Partition1\Yeti_Final_Xenon.exe). The manifest registers the filename.
+    if (query_file.empty()) {
+      continue;
+    }
+    const auto reg_slash = info.guest_path.rfind('/');
+    const std::string_view reg_file = reg_slash == std::string::npos
+                                         ? std::string_view(info.guest_path)
+                                         : std::string_view(info.guest_path).substr(reg_slash + 1);
+    if (reg_file == query_file) {
+      return info;
+    }
   }
   return std::nullopt;
 }
 
+void KernelState::ReleaseExecutableImage() {
+  // An executable attached from a module library also has a module
+  // registration and a loaded library. Both must go, or attaching the same
+  // executable again later is refused as a duplicate.
+  std::string attached_key;
+  uint32_t image_lo = 0;
+  uint32_t image_hi = 0;
+  if (executable_module_) {
+    if (auto recomp = FindRecompiledModule(executable_module_->path())) {
+      auto global_lock = global_critical_region_.Acquire();
+      if (module_libraries_.count(recomp->guest_path)) {
+        attached_key = recomp->guest_path;
+      }
+    }
+    if (auto* xex = executable_module_->xex_module()) {
+      image_lo = xex->base_address();
+      image_hi = xex->base_address() + xex->image_size();
+    }
+  }
+
+  std::optional<std::pair<uint32_t, uint32_t>> cleared;
+  if (!attached_key.empty()) {
+    cleared = function_dispatcher_->UnregisterModule(attached_key);
+    if (cleared) {
+      cleared->first = std::min(cleared->first, image_lo);
+      cleared->second = std::max(cleared->second, image_hi);
+    } else if (image_hi) {
+      cleared = std::make_pair(image_lo, image_hi);
+    }
+    auto global_lock = global_critical_region_.Acquire();
+    auto lib_it = module_libraries_.find(attached_key);
+    deferred_unload_libraries_.push_back(std::move(lib_it->second));
+    module_libraries_.erase(lib_it);
+  } else {
+    cleared = function_dispatcher_->ReleaseEntrypoint();
+  }
+  if (cleared) {
+    for (auto& kernel_module : kernel_modules_) {
+      kernel_module->InvalidateThunkCacheInRange(cleared->first, cleared->second);
+    }
+  }
+  SetExecutableModule(nullptr);
+}
+
+bool KernelState::AttachRecompiledExecutable(std::string_view guest_path) {
+  auto recomp = FindRecompiledModule(guest_path);
+  if (!recomp || recomp->shared_lib_name.empty()) {
+    REXSYS_ERROR("No recompiled executable registered for '{}'", guest_path);
+    return false;
+  }
+  if (!executable_module_ || !executable_module_->xex_module()) {
+    REXSYS_ERROR("AttachRecompiledExecutable: no executable is loaded");
+    return false;
+  }
+
+  const auto lib_path = ResolveRecompiledLibrary(recomp->shared_lib_name);
+  REXSYS_INFO("Loading recompiled executable '{}' from {}", recomp->pe_name, lib_path.string());
+
+  const std::string lib_key = recomp->guest_path;
+  {
+    auto global_lock = global_critical_region_.Acquire();
+    if (module_libraries_.find(lib_key) != module_libraries_.end()) {
+      REXSYS_ERROR("Recompiled module '{}' is already loaded", lib_key);
+      return false;
+    }
+  }
+
+  rex::platform::DynamicLibrary library_local;
+  if (!library_local.Load(lib_path, rex::platform::SymbolResolution::kImmediate)) {
+    REXSYS_ERROR("Failed to load shared library '{}'", lib_path.string());
+    return false;
+  }
+
+  auto register_func = reinterpret_cast<runtime::FunctionDispatcher::RegisterFn>(
+      library_local.GetRawSymbol("ReXModule_Register"));
+  using GetImageInfoFn = const rex::PPCImageInfo* (*)();
+  auto get_image_info =
+      reinterpret_cast<GetImageInfoFn>(library_local.GetRawSymbol("ReXModule_GetImageInfo"));
+  if (!register_func || !get_image_info) {
+    REXSYS_ERROR("Recompiled library '{}' is missing its module exports", lib_path.string());
+    return false;
+  }
+
+  auto* xex = executable_module_->xex_module();
+  const auto* image_info = get_image_info();
+  if (!image_info || image_info->image_base != xex->base_address() ||
+      image_info->image_size != xex->image_size()) {
+    REXSYS_ERROR(
+        "Recompiled executable '{}' layout does not match the loaded XEX "
+        "(library {:08X}-{:08X}, XEX {:08X}-{:08X})",
+        recomp->pe_name, image_info ? image_info->image_base : 0,
+        image_info ? image_info->image_base + image_info->image_size : 0, xex->base_address(),
+        xex->base_address() + xex->image_size());
+    return false;
+  }
+
+  if (!function_dispatcher_->InitializeFunctionTable(image_info->code_base, image_info->code_size,
+                                                     image_info->image_base, image_info->image_size,
+                                                     /*is_entrypoint=*/true)) {
+    REXSYS_ERROR("InitializeFunctionTable failed for '{}'", recomp->pe_name);
+    return false;
+  }
+
+  function_dispatcher_->RegisterModule(lib_key, image_info->code_base, register_func);
+  auto global_lock = global_critical_region_.Acquire();
+  module_libraries_.emplace(lib_key, std::move(library_local));
+  REXSYS_INFO("Recompiled executable '{}' is registered", recomp->pe_name);
+  return true;
+}

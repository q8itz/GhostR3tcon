+std::filesystem::path ResolveRecompiledLibrary(const std::string& name) {
+  std::error_code ec;
+  auto exe = std::filesystem::read_symlink("/proc/self/exe", ec);
+  const auto dir = ec ? std::filesystem::path() : exe.parent_path();
+  const std::filesystem::path candidates[] = {
+      dir / ("lib" + name + ".so"),
+      dir / (name + ".so"),
+      std::filesystem::path(name),
+  };
+  for (const auto& candidate : candidates) {
+    if (!candidate.empty() && std::filesystem::exists(candidate)) {
+      return candidate;
+    }
+  }
+  return dir.empty() ? std::filesystem::path(name) : dir / ("lib" + name + ".so");
+}

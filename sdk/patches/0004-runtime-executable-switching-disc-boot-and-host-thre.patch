+std::optional<std::pair<uint32_t, uint32_t>> FunctionDispatcher::ReleaseEntrypoint() {
+  std::lock_guard<std::recursive_mutex> lock(dispatch_mutex_);
+  if (entrypoint_code_base_ == 0) {
+    return std::nullopt;
+  }
+
+  ModuleTableInfo* table = nullptr;
+  for (auto& mod : module_tables_) {
+    if (mod.code_base == entrypoint_code_base_) {
+      table = &mod;
+      break;
+    }
+  }
+  if (!table) {
+    entrypoint_code_base_ = 0;
+    return std::nullopt;
+  }
+
+  const uint32_t lo = std::min(table->image_base, table->code_base);
+  const uint32_t hi = table->thunk_limit;
+  const uint32_t code_base = table->code_base;
+  for (auto it = function_table_.begin(); it != function_table_.end();) {
+    if (it->first >= lo && it->first < hi) {
+      it = function_table_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+
+  memory_->DestroyFunctionTable(code_base);
+  module_tables_.erase(std::remove_if(module_tables_.begin(), module_tables_.end(),
+                                      [code_base](const ModuleTableInfo& mod) {
+                                        return mod.code_base == code_base;
+                                      }),
+                       module_tables_.end());
+  entrypoint_code_base_ = 0;
+  REXLOG_INFO("Released entrypoint function table {:08X}-{:08X}", lo, hi);
+  return std::make_pair(lo, hi);
+}
+
 }  // namespace rex::runtime

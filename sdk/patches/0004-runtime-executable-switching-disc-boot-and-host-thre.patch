+void Runtime::RequestDefaultXexRelaunch() {
+  int count = title_relaunch_requests_.fetch_add(1, std::memory_order_acq_rel) + 1;
+  if (count == 1) {
+    REXSYS_INFO("Title requested relaunch of default.xex; continuing in-process once");
+  } else {
+    REXSYS_ERROR("Title relaunch loop: default.xex requested again (count {}); stopping", count);
+  }
+}
+
+bool Runtime::ConsumeDefaultXexRelaunch() {
+  if (title_relaunch_requests_.load(std::memory_order_acquire) != 1) {
+    return false;
+  }
+  return !title_relaunch_used_.exchange(true, std::memory_order_acq_rel);
+}
+
+void Runtime::RequestExecutableSwitch(std::string path) {
+  std::lock_guard lock(executable_switch_mutex_);
+  pending_executable_switch_ = std::move(path);
+  REXSYS_INFO("Title requested executable switch to {}", pending_executable_switch_);
+}
+
+std::optional<std::string> Runtime::ConsumeExecutableSwitch() {
+  std::lock_guard lock(executable_switch_mutex_);
+  if (pending_executable_switch_.empty()) {
+    return std::nullopt;
+  }
+  std::string path = std::move(pending_executable_switch_);
+  pending_executable_switch_.clear();
+  return path;
+}
+
+X_STATUS Runtime::ReplaceExecutable(std::string_view path) {
+  REXSYS_INFO("Replacing executable with {}", path);
+  if (graphics_system_) {
+    graphics_system_->SetInterruptCallback(0, 0);
+  }
+
+  // Drops the dispatch table and the guest mapping before the new image
+  // is allocated at the same address.
+  kernel_state_->ReleaseExecutableImage();
+
+  X_STATUS status = LoadXexImage(path);
+  if (XFAILED(status)) {
+    return status;
+  }
+  if (kernel_state_->FindRecompiledModule(path)) {
+    if (!kernel_state_->AttachRecompiledExecutable(path)) {
+      return X_STATUS_UNSUCCESSFUL;
+    }
+    return X_STATUS_SUCCESS;
+  }
+
+  // Returning to the entrypoint (default.xex), whose code is linked into the
+  // host binary rather than loaded from a module library.
+  auto* xex = kernel_state_->GetExecutableModule()->xex_module();
+  if (!entrypoint_image_ || xex->base_address() != entrypoint_image_->image_base ||
+      xex->image_size() != entrypoint_image_->image_size) {
+    REXSYS_ERROR("{} has no recompiled code and is not the entrypoint image", path);
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  if (!AttachEntrypointImage()) {
+    return X_STATUS_UNSUCCESSFUL;
+  }
+  REXSYS_INFO("Entrypoint executable {} is registered", path);
+  return X_STATUS_SUCCESS;
+}
+
 }  // namespace rex

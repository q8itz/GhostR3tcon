diff --git a/src/codegen/phase_discover.cpp b/src/codegen/phase_discover.cpp
index 1c73548..f1c8a02 100644
--- a/src/codegen/phase_discover.cpp
+++ b/src/codegen/phase_discover.cpp
@@ -13,6 +13,7 @@
 #include "decoded_binary.h"
 #include <rex/codegen/function_scanner.h>
 
+#include <algorithm>
 #include <array>
 #include <bitset>
 #include <unordered_set>
@@ -190,6 +191,76 @@ void discoverFunction(CodegenContext& ctx, uint32_t funcAddr,
   }
 }
 
+// Every aligned dword in a non-code section that points at executable code is a
+// call target, whether or not it sits in a run beside a known entry. That
+// includes a lone slot and the instruction just after a blr. A halfword jump
+// table is not a dword pointer, so it is left alone. The lis/addi sweep stays
+// disabled.
+size_t registerIndirectCallTargets(CodegenContext& ctx) {
+  auto& graph = ctx.graph;
+  auto& binary = ctx.binary();
+
+  std::vector<uint32_t> targets;
+
+  for (const auto& section : binary.sections()) {
+    if (section.executable || !section.data || section.size < 4)
+      continue;
+    uint32_t addr = section.baseAddress;
+    uint32_t end = section.end();
+    if (addr & 3)
+      addr = (addr + 3) & ~3u;
+
+    while (addr + 4 <= end) {
+      uint32_t value = load_and_swap<uint32_t>(section.data + (addr - section.baseAddress));
+      addr += 4;
+      if ((value & 0x3) || !binary.isExecutable(value) || binary.isInImportExportRange(value))
+        continue;
+      if (graph.isEntryPoint(value))
+        continue;
+      targets.push_back(value);
+    }
+  }
+
+  std::sort(targets.begin(), targets.end());
+  targets.erase(std::unique(targets.begin(), targets.end()), targets.end());
+
+  size_t added = 0;
+  size_t aliased = 0;
+  for (uint32_t target : targets) {
+    if (graph.isEntryPoint(target))
+      continue;
+    // A slot that lands inside code this function already emits is another
+    // entry of that function, including the instruction just after a blr only
+    // when that address is not in a block. Discovering it as its own function
+    // would copy the suffix and lose the backward branch.
+    FunctionNode* owner = graph.getFunctionContaining(target);
+    bool inBlock = false;
+    if (owner) {
+      for (const auto& block : owner->blocks()) {
+        if (block.contains(target)) {
+          inBlock = true;
+          break;
+        }
+      }
+    }
+    if (inBlock && owner->base() != target) {
+      owner->addAlias(target);
+      aliased++;
+      REXCODEGEN_TRACE("Analyze: indirect target 0x{:08X} aliases 0x{:08X}", target,
+                       owner->base());
+      continue;
+    }
+    graph.addFunction(target, 4, FunctionAuthority::VTABLE, true);
+    added++;
+    REXCODEGEN_TRACE("Analyze: indirect target 0x{:08X}", target);
+  }
+  REXCODEGEN_INFO(
+      "Analyze: registered {} indirect call targets from pointer tables ({} new functions, {} "
+      "aliases)",
+      added + aliased, added, aliased);
+  return added;
+}
+
 void discoverAllFunctions(CodegenContext& ctx) {
   REXCODEGEN_TRACE("Analyze: starting iterative discovery...");
 
@@ -221,6 +292,11 @@ void discoverAllFunctions(CodegenContext& ctx) {
 
   REXCODEGEN_TRACE("Analyze: {} functions after call graph expansion", graph.functionCount());
 
+  // Pointer tables and lis/addi leaves are indirect targets with no direct bl.
+  // RTTI scanning does not see them. Register the whole set before block discovery
+  // so one codegen covers every slot, not one address per rebuild.
+  const size_t indirectTargets = registerIndirectCallTargets(ctx);
+
   // VTable scanning
   {
     VTableScanner vtScanner(binary);
@@ -242,6 +318,8 @@ void discoverAllFunctions(CodegenContext& ctx) {
       }
     }
 
+    newFunctions += indirectTargets;
+
     REXCODEGEN_TRACE("Analyze: VTable scan found {} vtables, {} new functions", vtables.size(),
                      newFunctions);
 

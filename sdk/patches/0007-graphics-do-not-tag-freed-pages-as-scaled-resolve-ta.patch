From 8cae73c6267d6fd5d78c11400956c47dfe83775f Mon Sep 17 00:00:00 2001
From: Ben Williams <213356824+q8itz@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:18:16 +0000
Subject: [PATCH 7/9] graphics: do not tag freed pages as scaled resolve
 targets

A resolve that lands after the guest freed its memory tagged those pages
as holding scaled resolve data. A texture the CPU later loaded there (the
GRAW HUD atlas) was then read from the stale scaled image, drawing the
menu's last frame as a green border at resolution scale 2x and above.
---
 include/rex/graphics/shared_memory.h    |  4 ++++
 src/graphics/pipeline/texture/cache.cpp | 12 ++++++++++++
 src/graphics/shared_memory.cpp          | 11 +++++++----
 3 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 4d85a2b..17f0f7f 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -95,6 +95,10 @@ class SharedMemory {
   // regions in those pages.
   void RangeWrittenByGpu(uint32_t start, uint32_t length);
 
+  // Whether the guest currently has the physical page containing the address
+  // allocated with read or write access.
+  bool IsPageAccessible(uint32_t address) const;
+
  protected:
   SharedMemory(memory::Memory& memory);
   // Call in implementation-specific initialization.
diff --git a/src/graphics/pipeline/texture/cache.cpp b/src/graphics/pipeline/texture/cache.cpp
index 76f5600..541b505 100644
--- a/src/graphics/pipeline/texture/cache.cpp
+++ b/src/graphics/pipeline/texture/cache.cpp
@@ -339,6 +339,18 @@ void TextureCache::MarkRangeAsResolved(uint32_t start_unscaled, uint32_t length_
       if (i == block_last && (page_last & 31) != 31) {
         add_bits &= (UINT32_C(1) << ((page_last & 31) + 1)) - 1;
       }
+      // A resolve that lands after the guest freed its memory must not tag it,
+      // or a texture later loaded there by the CPU (with no watch to clear the
+      // tag) would be read from the stale scaled image instead.
+      uint32_t bits_to_check = add_bits;
+      uint32_t bit_index;
+      while (rex::bit_scan_forward(bits_to_check, &bit_index)) {
+        bits_to_check &= ~(UINT32_C(1) << bit_index);
+        if (!shared_memory().IsPageAccessible(((i << 5) + bit_index) << 12)) {
+          add_bits &= ~(UINT32_C(1) << bit_index);
+          scaled_resolve_pages_[i] &= ~(UINT32_C(1) << bit_index);
+        }
+      }
       scaled_resolve_pages_[i] |= add_bits;
       scaled_resolve_pages_l2_[i >> 6] |= UINT64_C(1) << (i & 63);
     }
diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
index 8cca4d1..a24acf8 100644
--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -281,6 +281,12 @@ bool SharedMemory::AllocateSparseHostGpuMemoryRange(uint32_t offset_allocations,
   return false;
 }
 
+bool SharedMemory::IsPageAccessible(uint32_t address) const {
+  uint32_t protect = 0;
+  return memory().GetPhysicalHeap()->QueryProtect(address, &protect) &&
+         (protect & (memory::kMemoryProtectRead | memory::kMemoryProtectWrite));
+}
+
 void SharedMemory::MakeRangeValid(uint32_t start, uint32_t length, bool written_by_gpu) {
   if (length == 0 || start >= kBufferSize) {
     return;
@@ -299,11 +305,8 @@ void SharedMemory::MakeRangeValid(uint32_t start, uint32_t length, bool written_
   // would keep showing the menu's last front buffer (the green frame).
   std::vector<uint64_t> unallocated;
   if (written_by_gpu) {
-    memory::VirtualHeap* physical_heap = memory().GetPhysicalHeap();
     for (uint32_t page = valid_page_first; page <= valid_page_last; ++page) {
-      uint32_t protect = 0;
-      if (!physical_heap->QueryProtect(page << page_size_log2_, &protect) ||
-          !(protect & (memory::kMemoryProtectRead | memory::kMemoryProtectWrite))) {
+      if (!IsPageAccessible(page << page_size_log2_)) {
         if (unallocated.empty()) {
           unallocated.resize(valid_block_last - valid_block_first + 1);
         }
